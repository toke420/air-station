# AirStation settings. scripts/init.py creates .env from this file.
# After editing: docker compose up -d   (and for NAS settings: systemctl start air-sync)

# Public address of the new platform. Its DNS A record must point at this VPS.
AIR_DOMAIN=radio.example.com
# Let's Encrypt contact address (expiry warnings only).
AIR_ACME_EMAIL=you@example.com
AIR_TZ=UTC
AIR_STATION_NAME=AirStation

# Music folder inside the SMB mount (see docs/DEPLOY.md step 7).
AIR_NAS_PATH=/mnt/air-nas/Music

# Local cache on the VPS (GiB). The pool is what keeps the radio playing
# while home is offline: ~6 GiB of 192 kbps MP3s is roughly 70 hours of music.
AIR_CACHE_MAX_GB=12
AIR_POOL_GB=6
# Free space always left on the disk; caching and recording stop below this.
AIR_DISK_RESERVE_GB=10
# How often to rescan the whole NAS for new/changed files.
AIR_INDEX_HOURS=6
# Most data copied from home per 5-minute sync run (MiB).
AIR_FETCH_PER_RUN_MB=600

# When a DJ connects (Mixxx/OBS): "track" = go on air when the current song
# ends (admin "Skip track" = go live now); "immediate" = cut in straight away.
# Apply with: docker compose up -d liquidsoap
AIR_LIVE_SWITCH=track

# Owncast server shown on the Live Video page (can also be changed in admin).
AIR_OWNCAST_URL=https://cast.example.com

# Map in Studio > Listeners. Normally chosen in Studio > Site settings > Listener map
# (OpenStreetMap needs no key; CARTO needs a free key). Setting AIR_MAP_TILES here
# overrides that choice: any XYZ tile URL ({s} {z} {x} {y}, {r} = @2x), e.g.
#   AIR_MAP_TILES=https://tiles.example.com/{z}/{x}/{y}.png
#   AIR_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Apply with: docker compose up -d api
AIR_MAP_TILES=
AIR_MAP_ATTRIBUTION=

# Community add-on (forum + single sign-on). Filled in by:
#   python3 scripts/community.py init      (see docs/COMMUNITY-SETUP.md)
AIR_ID_DOMAIN=id.example.com
AIR_FORUM_DOMAIN=forum.example.com
AIR_ADMIN_EMAIL=
AIR_SMTP_HOST=
AIR_SMTP_PORT=587
AIR_SMTP_USERNAME=
AIR_SMTP_FROM=
AIR_SMTP_TLS=starttls

# HLS stream (/radio.m3u8) for IPTV apps and playlists: AAC bitrate.
# Apply with: docker compose up -d hls
AIR_HLS_BITRATE=128k

# Upstream images. Pin exact versions once you have a known-good deployment.
AIR_LIQUIDSOAP_IMAGE=savonet/liquidsoap:v2.4.5
AIR_MEDIAMTX_IMAGE=bluenviron/mediamtx:latest-ffmpeg
# Image providing ffmpeg for the HLS stream (any image with ffmpeg on its PATH works).
AIR_FFMPEG_IMAGE=bluenviron/mediamtx:latest-ffmpeg
AIR_CADDY_IMAGE=caddy:2
AIR_RAUTHY_IMAGE=ghcr.io/sebadob/rauthy:0.37.0
AIR_NODEBB_IMAGE=ghcr.io/nodebb/nodebb:latest
AIR_POSTGRES_IMAGE=postgres:17-alpine
