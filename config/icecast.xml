<icecast>
  <!-- Template. Passwords and hostname are filled in at container start by
       airstation.icecast_start from Docker secrets and AIR_DOMAIN. -->
  <location>Australia</location>
  <admin>admin@localhost</admin>
  <hostname>radio.example.com</hostname>
  <limits>
    <clients>500</clients>
    <sources>4</sources>
    <queue-size>524288</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <burst-on-connect>1</burst-on-connect>
    <burst-size>65535</burst-size>
  </limits>
  <authentication>
    <source-password>GENERATED_AT_STARTUP</source-password>
    <relay-password>GENERATED_AT_STARTUP</relay-password>
    <admin-user>admin</admin-user>
    <admin-password>GENERATED_AT_STARTUP</admin-password>
  </authentication>
  <listen-socket>
    <port>8000</port>
  </listen-socket>
  <http-headers>
    <header name="Access-Control-Allow-Origin" value="*" />
  </http-headers>
  <fileserve>1</fileserve>
  <paths>
    <basedir>/usr/share/icecast2</basedir>
    <logdir>/tmp</logdir>
    <webroot>/usr/share/icecast2/web</webroot>
    <adminroot>/usr/share/icecast2/admin</adminroot>
    <alias source="/" destination="/status.xsl"/>
  </paths>
  <logging>
    <accesslog>-</accesslog>
    <errorlog>-</errorlog>
    <loglevel>3</loglevel>
  </logging>
  <security>
    <chroot>0</chroot>
  </security>
</icecast>
