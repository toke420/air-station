# Forum placeholder while NodeBB's first-time installer runs (it is only
# reachable through an SSH tunnel). scripts/community.py finish swaps this
# for forum-live.caddy.
{$AIR_FORUM_DOMAIN} {
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-store"
	respond `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><title>AirStation Community</title><body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#07090d;color:#eef2f7;font:16px system-ui,sans-serif;text-align:center"><div><h1 style="font-weight:600">AirStation Community</h1><p>The forum is being set up. Check back soon.</p><p><a style="color:#1f9bff" href="https://{$AIR_DOMAIN}/">Back to the radio</a></p></div>` 503
}
