[Unit]
Description=AirStation NAS index and cache sync
Documentation=file:///opt/air-station/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target wg-quick@wg-air.service docker.service

[Service]
Type=oneshot
User=air
Group=air
WorkingDirectory=/opt/air-station
Environment=PYTHONPATH=/opt/air-station/app
Environment=AIR_ROOT=/opt/air-station
ExecStart=/usr/bin/python3 -m airstation.sync
# A stalled SMB read is killed here; the radio is unaffected.
TimeoutStartSec=45min
TimeoutStopSec=30s
KillMode=control-group
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
# Exit code 3 = NAS unreachable (normal while home is offline), not a failure.
SuccessExitStatus=3
